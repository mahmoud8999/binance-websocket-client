Screen {
    layout: vertical;
}


/* =========================================================
   SYMBOL SELECTOR
   ========================================================= */

#symbol-selector {
    width: 100%;
    height: auto;

    align: center middle;

    padding: 1 0;
}


.symbol-row {
    width: 100%;
    height: 3;

    align: center middle;
}


Checkbox {
    width: 16;
    height: 3;

    margin: 0 1;
}


/* =========================================================
   MARKET TABLE
   ========================================================= */

#table-container {
    width: 100%;
    height: 1fr;

    align-horizontal: center;
}


#market-table {
    width: 90%;
    height: 1fr;
}


/* =========================================================
   CONNECTION / STREAM STATUS
   ========================================================= */

#status-bar {
    width: 90%;
    height: 3;

    padding: 1 2;
}


#connection-status {
    width: 1fr;

    content-align: left middle;
}


#stream-status {
    width: 1fr;

    content-align: right middle;
}
